# Credenciales de TiDB
# Para TiDB Cloud el puerto suele ser 4000 y la conexión requiere TLS.
TIDB_HOST=tu-host.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=tu_usuario
TIDB_PASSWORD=tu_password
TIDB_DATABASE=sistema_asistencia

# Ruta al certificado CA descargado desde TiDB Cloud (p. ej. isrgrootx1.pem).
# Déjalo vacío solo si usas un TiDB local sin TLS.
TIDB_SSL_CA=

# Rutas del modelo
MODEL_PATH=models/modelo_asistencia.keras
MODEL_CONFIG_PATH=models/model_config.json

# Orígenes permitidos (frontend Vite)
CORS_ORIGINS=http://localhost:5173
